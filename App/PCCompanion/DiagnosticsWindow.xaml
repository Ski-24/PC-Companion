<Window x:Class="PCCompanion.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics / About"
        Width="460" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="DiagButton" TargetType="Border">
            <Setter Property="Height"       Value="34"/>
            <Setter Property="MinWidth"     Value="124"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background"   Value="{DynamicResource BtnBrush}"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Margin"       Value="4"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid Grid.Row="0" Background="Transparent" Margin="20,16,14,6"
                  MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Diagnostics / About"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Text=""
                               Margin="10,0,0,0"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{DynamicResource DimBrush}" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Border Width="28" Height="28" CornerRadius="14"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource BtnBrush}" Cursor="Hand"
                        MouseLeftButtonDown="OnClose">
                    <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="13"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Margin="20,0,10,0" VerticalScrollBarVisibility="Auto">
                <!-- Same slim, rounded, theme-matching scrollbar as the main popup. -->
                <ScrollViewer.Resources>
                    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="RoundScrollThumb" TargetType="Thumb">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbBorder" CornerRadius="3.5"
                                            Background="{DynamicResource DimBrush}" Opacity="0.5"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ScrollBar">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Width" Value="7"/>
                        <Setter Property="Margin" Value="0,20,8,20"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                              Command="ScrollBar.PageUpCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource RoundScrollThumb}"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                              Command="ScrollBar.PageDownCommand"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel x:Name="Rows" Margin="0,0,8,0"/>
            </ScrollViewer>

            <!-- Action buttons -->
            <WrapPanel Grid.Row="2" Margin="14,10,14,16" HorizontalAlignment="Center">
                <Border Style="{StaticResource DiagButton}" MouseLeftButtonDown="OnOpenLogs">
                    <TextBlock Text="Open Logs Folder" Margin="14,0" FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource DiagButton}" MouseLeftButtonDown="OnOpenConfig">
                    <TextBlock Text="Open Config Folder" Margin="14,0" FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource DiagButton}" MouseLeftButtonDown="OnCopy">
                    <TextBlock Text="Copy Diagnostics" Margin="14,0" FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource DiagButton}" MouseLeftButtonDown="OnReset">
                    <TextBlock Text="Reset Settings" Margin="14,0" FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="CheckUpdatesBtn" Style="{StaticResource DiagButton}" MouseLeftButtonDown="OnCheckUpdates">
                    <TextBlock x:Name="CheckUpdatesText" Text="Check for Updates" Margin="14,0"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </Border>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
