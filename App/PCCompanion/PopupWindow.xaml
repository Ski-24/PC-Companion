<Window x:Class="PCCompanion.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="1040"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Window is ALWAYS 580px tall and never resizes.
        The Border grows/shrinks via SettingsPanel.MaxHeight animation only.
        Transparent pixels above the Border are click-through (layered window),
        so Deactivated fires correctly when the user clicks away.
    -->
    <Border x:Name="PopupBorder"
            CornerRadius="32"
            Background="{DynamicResource BgBrush}"
            VerticalAlignment="Bottom">
        <!-- Responsive safeguard: inert on displays large enough for the normal popup
             (with Auto, no scrollbar appears and layout + the settings animation are
             unchanged). On short displays / high scaling it scrolls instead of clipping.
             RootScroller.MaxHeight is set per-show in PositionWindow. -->
        <ScrollViewer x:Name="RootScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Slim, rounded, theme-matching scrollbar. Scoped here (implicit styles in
                 ScrollViewer.Resources) so only this popup's scrollbar is affected. Inset
                 via Margin so the thumb sits inside the rounded Border, never poking past
                 the 32px corner curve. Purely cosmetic — scroll behavior is unchanged. -->
            <ScrollViewer.Resources>
                <!-- Transparent, click-through page regions (track-click paging still works) -->
                <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Rounded, subtle thumb that brightens on hover -->
                <Style x:Key="RoundScrollThumb" TargetType="Thumb">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbBorder" CornerRadius="3.5"
                                        Background="{DynamicResource DimBrush}" Opacity="0.5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Implicit ScrollBar style: slim width, inset from the edges, no arrows -->
                <Style TargetType="ScrollBar">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="Margin" Value="0,20,8,20"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource RoundScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
        <StackPanel>

            <!-- ── Update banner: hidden until a newer release is found (TrayManager startup
                 check → ShowUpdateAvailable). Click anywhere to download + install; the ✕
                 dismisses it for this session. Collapsed by default so layout is unchanged. ── -->
            <!-- Fixed dark green (NOT the theme GoodBrush) so the white text/icon stay
                 readable in every theme — the light themes' green washed the text out. -->
            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    Margin="18,14,18,0" Height="42" CornerRadius="16"
                    Background="#15803D"
                    Cursor="Hand"
                    MouseLeftButtonDown="OnUpdateBannerClick">
                <Grid>
                    <TextBlock Text="⬇" FontFamily="Segoe UI Symbol" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"
                               Margin="16,0,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="UpdateBannerText"
                               Text="Update available — click to see what's new"
                               Margin="42,0,40,0"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Width="28" Height="28" CornerRadius="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,7,0" Background="#33000000" Cursor="Hand"
                            ToolTip="Dismiss"
                            MouseLeftButtonDown="OnUpdateBannerDismiss">
                        <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── "What's new" popup — opens when the update banner is clicked. Shows the
                 pending release's GitHub notes (same rounded BtnBrush styling as the help
                 tooltip) with an Update-now action. A real Popup so it can extend past the
                 window; StaysOpen=False lets an outside click dismiss it. ── -->
            <Popup x:Name="UpdateNotesPopup"
                   PlacementTarget="{Binding ElementName=UpdateBanner}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border Width="384" CornerRadius="14" Margin="8"
                        Background="{DynamicResource BtnBrush}">
                    <StackPanel>
                        <Grid Margin="16,14,10,8">
                            <TextBlock x:Name="UpdateNotesTitle" Text="What's new"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Right"
                                    Background="#22000000" Cursor="Hand" ToolTip="Close"
                                    MouseLeftButtonDown="OnUpdateNotesClose">
                                <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                      Margin="16,0,10,10">
                            <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap"
                                       FontFamily="Segoe UI" FontSize="13" LineHeight="19"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </ScrollViewer>
                        <Grid Margin="16,0,16,14">
                            <TextBlock x:Name="UpdateNotesGitHub" Text="View on GitHub"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Opacity="0.7"
                                       TextDecorations="Underline" Cursor="Hand"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       MouseLeftButtonDown="OnUpdateNotesGitHub"/>
                            <Border HorizontalAlignment="Right" CornerRadius="15" Height="34"
                                    Background="#15803D" Cursor="Hand" Padding="18,0"
                                    MouseLeftButtonDown="OnUpdateNotesInstall">
                                <TextBlock x:Name="UpdateNotesInstallText" Text="Update now"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ── Main area: cards + settings toggle (height set dynamically by LayoutCards) ── -->
            <Canvas x:Name="CardsCanvas" Width="420" Height="344">

                <!-- Branding header: goblin logo + title (Edit button = EditModeBtn below, drawn on top) -->
                <Border Canvas.Left="18" Canvas.Top="14"
                        Width="384" Height="44" CornerRadius="16"
                        Background="{DynamicResource CardBrush}"/>
                <Ellipse Canvas.Left="34" Canvas.Top="19" Width="34" Height="34" Fill="#16302C"/>
                <Image x:Name="LogoImage"
                       Canvas.Left="34" Canvas.Top="19" Width="34" Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/>
                    </Image.Clip>
                </Image>
                <TextBlock Canvas.Left="80" Canvas.Top="24"
                           Text="PC Companion"
                           FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>

                <!-- Gopher360 card -->
                <Border x:Name="GopherCard"
                        Canvas.Left="18" Canvas.Top="18"
                        Width="384" Height="70"
                        CornerRadius="24"
                        Background="{DynamicResource CardBrush}"
                        RenderOptions.ClearTypeHint="Enabled"
                        TextOptions.TextRenderingMode="ClearType"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnGopherClick">
                    <Canvas>
                        <Grid Canvas.Left="14" Canvas.Top="13" Width="46" Height="44">
                            <TextBlock Text="🎮" FontFamily="Segoe UI Emoji" FontSize="24"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Canvas.Left="74" Canvas.Top="10"
                                   Width="155" Height="28"
                                   Text="Gopher360"
                                   FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="GopherStatus"
                                   Canvas.Left="74" Canvas.Top="40"
                                   Width="155" Height="22"
                                   Text="● OFF"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource BadBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border x:Name="GopherHelp"
                                Canvas.Left="240" Canvas.Top="22"
                                Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource BtnBrush}" Cursor="Hand">
                            <TextBlock Text="?" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Canvas.Left="274" Canvas.Top="18"
                                Width="92" Height="34" CornerRadius="17"
                                Background="{DynamicResource BtnBrush}"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnGopherClick">
                            <TextBlock x:Name="GopherBtn" Text="Turn On"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Audio card -->
                <Border x:Name="AudioCard"
                        Canvas.Left="18" Canvas.Top="106"
                        Width="384" Height="70"
                        CornerRadius="24"
                        Background="{DynamicResource CardBrush}"
                        RenderOptions.ClearTypeHint="Enabled"
                        TextOptions.TextRenderingMode="ClearType"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnAudioClick">
                    <Canvas>
                        <Grid Canvas.Left="14" Canvas.Top="13" Width="46" Height="44">
                            <TextBlock Text="🎧" FontFamily="Segoe UI Emoji" FontSize="24"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Canvas.Left="74" Canvas.Top="10"
                                   Width="155" Height="28"
                                   Text="Audio"
                                   FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="AudioStatus"
                                   Canvas.Left="74" Canvas.Top="40"
                                   Width="155" Height="22"
                                   Text="● —"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource DimBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border x:Name="AudioHelp"
                                Canvas.Left="240" Canvas.Top="22"
                                Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource BtnBrush}" Cursor="Hand">
                            <TextBlock Text="?" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Canvas.Left="274" Canvas.Top="18"
                                Width="92" Height="34" CornerRadius="17"
                                Background="{DynamicResource BtnBrush}"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnAudioClick">
                            <TextBlock x:Name="AudioBtn" Text="Switch"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Display card: HDR toggle + Auto HDR toggle + context-sensitive slider -->
                <Border x:Name="DisplayCard"
                        Canvas.Left="18" Canvas.Top="194"
                        Width="384" Height="140"
                        CornerRadius="24"
                        Background="{DynamicResource CardBrush}"
                        RenderOptions.ClearTypeHint="Enabled"
                        TextOptions.TextRenderingMode="ClearType">
                    <Canvas>
                        <Grid Canvas.Left="14" Canvas.Top="8" Width="46" Height="44">
                            <TextBlock Text="☀" FontFamily="Segoe UI Emoji" FontSize="24"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Canvas.Left="74" Canvas.Top="8"
                                   Width="155" Height="26"
                                   Text="HDR"
                                   FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="HdrStatus"
                                   Canvas.Left="74" Canvas.Top="34"
                                   Width="155" Height="18"
                                   Text="● OFF"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource BadBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border x:Name="HdrHelp"
                                Canvas.Left="240" Canvas.Top="15"
                                Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource BtnBrush}" Cursor="Hand">
                            <TextBlock Text="?" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Canvas.Left="274" Canvas.Top="15"
                                Width="92" Height="34" CornerRadius="17"
                                Background="{DynamicResource BtnBrush}"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnHdrClick">
                            <TextBlock x:Name="HdrBtn" Text="Turn On"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Brightness row — visible when HDR off -->
                        <TextBlock x:Name="BrightnessDimLabel"
                                   Canvas.Left="14" Canvas.Top="58"
                                   Text="Brightness"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="{DynamicResource DimBrush}"/>
                        <TextBlock x:Name="BrightnessLabel"
                                   Canvas.Left="300" Canvas.Top="58"
                                   Width="70" Height="13"
                                   Text="···"
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource DimBrush}"/>
                        <Slider x:Name="BrightnessSlider"
                                Canvas.Left="14" Canvas.Top="73"
                                Width="356" Height="22"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Style="{StaticResource ThinSlider}"
                                ValueChanged="OnBrightnessChanged"/>

                        <!-- Software Dim row — revealed when brightness bottoms out at 0 (HDR off);
                             drives the compositor effect below the hardware backlight floor -->
                        <TextBlock x:Name="DimDimLabel"
                                   Canvas.Left="14" Canvas.Top="100"
                                   Text="Dim"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="{DynamicResource DimBrush}"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="DimValueLabel"
                                   Canvas.Left="300" Canvas.Top="100"
                                   Width="70" Height="13"
                                   Text="0%"
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource DimBrush}"
                                   Visibility="Collapsed"/>
                        <Slider x:Name="DimSlider"
                                Canvas.Left="14" Canvas.Top="115"
                                Width="356" Height="22"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Style="{StaticResource ThinSlider}"
                                ValueChanged="OnDimChanged"
                                Visibility="Collapsed"/>

                        <!-- SDR Balance row — same position as Brightness, visible when HDR on -->
                        <TextBlock x:Name="SdrDimLabel"
                                   Canvas.Left="14" Canvas.Top="58"
                                   Text="SDR Balance"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="{DynamicResource DimBrush}"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="SdrValueLabel"
                                   Canvas.Left="270" Canvas.Top="58"
                                   Width="100" Height="13"
                                   Text=""
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource DimBrush}"
                                   Visibility="Collapsed"/>
                        <Slider x:Name="SdrSlider"
                                Canvas.Left="14" Canvas.Top="73"
                                Width="356" Height="22"
                                Minimum="3.0" Maximum="6.0"
                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                Style="{StaticResource ThinSlider}"
                                ValueChanged="OnSdrChanged"
                                Visibility="Collapsed"/>

                        <!-- Auto HDR row — default Y is for no-slider case; code shifts it down when slider visible -->
                        <TextBlock x:Name="AutoHdrLabel"
                                   Canvas.Left="74" Canvas.Top="54"
                                   Text="Auto HDR"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource DimBrush}"/>
                        <TextBlock x:Name="AutoHdrStatus"
                                   Canvas.Left="74" Canvas.Top="70"
                                   Width="155" Height="18"
                                   Text="● —"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource DimBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border x:Name="AutoHdrBtnBorder"
                                Canvas.Left="274" Canvas.Top="52"
                                Width="92" Height="30" CornerRadius="15"
                                Background="{DynamicResource BtnBrush}"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnAutoHdrClick">
                            <TextBlock x:Name="AutoHdrBtn" Text="···"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Prayer card -->
                <Border x:Name="PrayerCard"
                        Canvas.Left="18" Canvas.Top="312"
                        Width="384" Height="80"
                        CornerRadius="24"
                        Background="{DynamicResource CardBrush}"
                        RenderOptions.ClearTypeHint="Enabled"
                        TextOptions.TextRenderingMode="ClearType">
                    <Canvas>
                        <Grid Canvas.Left="14" Canvas.Top="17" Width="46" Height="46">
                            <TextBlock Text="🕌" FontFamily="Segoe UI Emoji" FontSize="24"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Canvas.Left="74" Canvas.Top="29"
                                   Text="Prayer"
                                   FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border x:Name="PrayerHelp"
                                Canvas.Left="150" Canvas.Top="27"
                                Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource BtnBrush}" Cursor="Hand">
                            <TextBlock Text="?" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Button-style box on the right, matching other cards' Turn On/Off buttons -->
                        <Border Canvas.Left="182" Canvas.Top="13"
                                Width="184" Height="54" CornerRadius="27"
                                Background="{DynamicResource BtnBrush}">
                            <StackPanel VerticalAlignment="Center" Margin="10,0">
                                <TextBlock x:Name="PrayerStatus"
                                           Text="Loading..."
                                           FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource AmberBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="PrayerCountdown"
                                           Text=""
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource DimBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Edit mode toggle — top-right, styled like the action buttons -->
                <Border x:Name="EditModeBtn"
                        Canvas.Left="294" Canvas.Top="19"
                        Width="92" Height="34" CornerRadius="17"
                        Background="{DynamicResource BtnBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnEditModeToggle">
                    <TextBlock x:Name="EditModeText" Text="Edit"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Help tooltip — uses a real Popup so it can extend beyond the window bounds -->
                <Popup x:Name="HelpPopup"
                       Placement="Top"
                       AllowsTransparency="True"
                       PopupAnimation="None"
                       StaysOpen="True"
                       HorizontalOffset="-119"
                       VerticalOffset="-8">
                    <Border x:Name="HelpPopupBorder"
                            Width="264" CornerRadius="12" Padding="12,10"
                            Background="{DynamicResource BtnBrush}">
                        <TextBlock x:Name="HelpPopupText"
                                   TextWrapping="Wrap" FontFamily="Segoe UI"
                                   FontSize="13" Foreground="{DynamicResource TextBrush}" LineHeight="20"/>
                    </Border>
                </Popup>

                <!-- Couch / Morning scene buttons — two compact pills side by side (same
                     BtnBrush style as the card action buttons). Canvas.Top is set
                     dynamically by LayoutCards; Canvas.Left positions them in one row. -->
                <Border x:Name="CouchModeBtn"
                        Canvas.Left="40" Canvas.Top="402"
                        Width="165" Height="34" CornerRadius="17"
                        Background="{DynamicResource BtnBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnCouchModeClick">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="CouchModeText"
                                   Text="Couch Mode"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CouchModeStatus"
                                   Text="● OFF"
                                   Margin="8,0,0,0"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource BadBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="MorningModeBtn"
                        Canvas.Left="215" Canvas.Top="402"
                        Width="165" Height="34" CornerRadius="17"
                        Background="{DynamicResource BtnBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnMorningModeClick">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="MorningModeText"
                                   Text="Morning"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="MorningModeStatus"
                                   Text="● OFF"
                                   Margin="8,0,0,0"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource BadBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Settings toggle -->
                <TextBlock x:Name="SettingsToggleBtn"
                           Canvas.Left="0" Canvas.Top="402"
                           Width="420" Height="24"
                           Text="⚙   Settings"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{DynamicResource DimBrush}"
                           TextAlignment="Center"
                           Cursor="Hand"
                           MouseLeftButtonDown="OnSettingsToggle"/>
            </Canvas>

            <!-- Settings panel BELOW the cards.
                 MaxHeight=0 when collapsed, animates to 242 on expand.
                 Border (VerticalAlignment=Bottom) grows upward as this expands,
                 so the cards move up and settings reveal underneath — no HWND resize. -->
            <Canvas x:Name="SettingsPanel"
                    Width="420" Height="1300"
                    MaxHeight="0"
                    ClipToBounds="True"/>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
